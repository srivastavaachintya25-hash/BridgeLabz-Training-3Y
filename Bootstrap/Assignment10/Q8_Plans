
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Pricing Plans</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<header class="text-center py-5">
    <h1>Choose Your Plan</h1>
    <p class="lead">Simple pricing for every team</p>
</header>

<main class="container pb-5">
    <div class="row g-4">

        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h2>Basic</h2>
                    <h3>₹299</h3>
                    <p>5 Projects</p>
                    <p>Basic Support</p>
                    <p>5 GB Storage</p>
                    <button class="btn btn-outline-primary">Choose Plan</button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center border-primary h-100">
                <div class="card-header bg-primary text-white">Popular</div>
                <div class="card-body">
                    <h2>Pro</h2>
                    <h3>₹699</h3>
                    <p>Unlimited Projects</p>
                    <p>Priority Support</p>
                    <p>50 GB Storage</p>
                    <button class="btn btn-primary">Choose Plan</button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h2>Business</h2>
                    <h3>₹1,299</h3>
                    <p>Team Collaboration</p>
                    <p>Premium Support</p>
                    <p>200 GB Storage</p>
                    <button class="btn btn-outline-primary">Choose Plan</button>
                </div>
            </div>
        </div>

    </div>
</main>

</body>
</html>
